   "previous_help": "\n    Prints the sudoers config to STDOUT and DOES NOT modify anything.\n    ",
   "attribution": "own"
  },
  {
   "flag": "--sudoers-user",
   "event": "help_changed",
   "tag": "v1.1.1",
   "date": "2022-09-06T08:17:47+10:00",
   "source": "parsed",
   "kind": "option",
   "help": "\n    Set the user name or group with %%group_name for passwordless operation.\n    Default is the current user. Only works with the --sudoers-no-modify option.\n    ",
   "previous_help": "\n    Set the user name or group with %%group_name for passwordless operation.\n    Default is the current user.set ALL for all users. Only works with\n    --sudoers or --sudoers-no-modify option.\n    ",
   "attribution": "own"
  },
  {
